{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
  },
  "display": {
    "separator": " - ",

    "color": {
      "keys": "cyan",
      "title": "green",
      "separator": "black",
      "output": "blue",
    },
    "constants": [
      "│\u001b[46C│\u001b[47D",
      "──────────────────────────────────────────────",
      "\u001b[1Do",
      "\u001b[46Co\u001b[47D",
    ],
  },
  "modules": [
    {
      "type": "title",
      "format": "{#keys}╭{$2}╮\u001b[44D {#title}{user-name}@{host-name} {#keys}\u001b[9Co\u001b[6Co",
    },
    {
      "type": "custom",
      "format": "{#keys}{$1}",
    },

    {
      "type": "cpu",
      "key": "{$1} PROCESSING_UNIT",
      "format": "{1}",
    },
    {
      "type": "gpu",
      "key": "{$1} VISUAL_RENDERER",
      "format": "{2}",
      "hideType": "integrated",
    },
    {
      "type": "memory",
      "key": "{$1}{$3} BUFFER_CAPACITY",
      "format": "{2}",
    },
    {
      "type": "swap",
      "key": "{$1} SWAP_CAPACITY  ",
      "format": "{2}",
    },
    {
      "type": "physicaldisk",
      "key": "{$1} DATA_ARCHIVE   ",
      "format": "{2}",
    },
    {
      "type": "display",
      "key": "{$1} PROJECTOR      ",
      "format": "{1}x{2}@{3}",
    },

    {
      "type": "custom",
      "format": "{#keys}{$1}",
    },

    {
      "type": "uptime",
      "key": "{$1}{$4} SYSTEM_UPTIME  ",
      "format": "{days}d {hours}h {minutes}m",
    },

    {
      "type": "custom",
      "format": "{#keys}{$1}",
    },

    {
      "type": "kernel",
      "key": "{$1}{$3} KERNEL_VERSION ",
      "format": "{2}",
    },
    {
      "type": "shell",
      "key": "{$1}{$4} SHELL_INTERFACE",
      "format": "{pretty-name} {version}",
    },
    {
      "type": "wm",
      "key": "{$1} WINDOW_MANAGER ",
      "format": "{pretty-name} {version}",
    },
    {
      "type": "terminal",
      "key": "{$1} TERMINAL_APP   ",
      "format": "{pretty-name} {version}",
    },

    {
      "type": "custom",
      "format": "{#keys}{$1}",
    },

    {
      "type": "theme",
      "key": "{$1} VISUAL_SCHEME ",
      "format": "{theme1}{theme2}",
    },
    {
      "type": "icons",
      "key": "{$1} SYMBOL_SET    ",
      "format": "{icons1}{icons2}",
    },
    {
      "type": "font",
      "key": "{$1}{$3} DISPLAY_CODEC ",
      "format": "{font2}",
    },
    {
      "type": "cursor",
      "key": "{$1}{$4} POINTER_RENDER",
      "format": "{theme} {size}",
    },
    {
      "type": "terminalfont",
      "key": "{$1} CONSOLE_RENDER",
      "format": "{name} {size}pt",
    },
    {
      "type": "colors",
      "key": "{$1} COLOR_LAYOUT",
      "symbol": "square",
    },

    {
      "type": "custom",
      "format": "{#keys}{$1}",
    },
    {
      "type": "custom",
      "format": "{#keys}╰{$2}╯\u001b[40Do\u001b[15C LAYER_07_PROTOCOL \u001b[2Co",
    },
  ],
}
